{
  "name": "@stryketrade/sdk",
  "version": "0.1.19",
  "description": "Public TypeScript SDK for Stryke prediction markets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannydoritoeth/stryke-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/dannydoritoeth/stryke-sdk#readme",
  "bugs": {
    "url": "https://github.com/dannydoritoeth/stryke-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@pythnetwork/hermes-client": "^2.1.0",
    "@solana/kit": "^7.0.0"
  }
}
