# The default command is a deterministic read-only smoke and requires no wallet.
STRYKE_API_BASE_URL=https://devnet-api.example.invalid

# Live mode remains blocked unless all three values are deliberately changed.
STRYKE_READ_ONLY_MODE=true
STRYKE_LIVE_TRADING_ENABLED=false
STRYKE_KILL_SWITCH_ENABLED=true

# A module path, never a seed phrase or inline private key.
# STRYKE_WALLET_ADAPTER_PATH=./wallet-adapter.js
