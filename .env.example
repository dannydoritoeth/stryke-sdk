# Copy this file to .env. The command selects paper/devnet/live safely.
# These are deliberately minimum-size educational settings.
STRYKE_ASSET=BTC
STRYKE_EXPIRY_FAMILY=five_minute
STRYKE_ESTIMATOR=volatility_adjusted_probability
STRYKE_TRADE_SIZE_SOL=0.001
STRYKE_MAXIMUM_TRADE_SIZE_SOL=0.001
STRYKE_MAXIMUM_AGGREGATE_EXPOSURE_SOL=0.001
STRYKE_FEE_FREE_ACTIVATION_LIMIT_SOL=10
STRYKE_FEE_FREE_BUFFER_SOL=0.5
STRYKE_MINIMUM_ENTRY_EDGE_BPS=500
STRYKE_MAXIMUM_PRICE_IMPACT_BPS=100
STRYKE_MINIMUM_SECONDS_TO_EXPIRY=60
STRYKE_MAXIMUM_OPEN_POSITIONS=1
STRYKE_TICK_INTERVAL_MS=5000
STRYKE_STOP_LOSS_BPS=1000
STRYKE_TAKE_PROFIT_BPS=2000
STRYKE_PRICE_HISTORY_MAX_POINTS=20000
STRYKE_HISTORY_LOOKBACK_SECONDS_1M=180
STRYKE_HISTORY_LOOKBACK_SECONDS_5M=600
STRYKE_HISTORY_LOOKBACK_SECONDS_15M=1800
STRYKE_HISTORY_LOOKBACK_SECONDS_1H=10800
STRYKE_MINIMUM_HISTORY_COVERAGE_BPS=8000
# Realised volatility is expressed as basis points per square-root hour.
STRYKE_MINIMUM_VOLATILITY_BPS_PER_SQRT_HOUR=5
STRYKE_MAXIMUM_VOLATILITY_BPS_PER_SQRT_HOUR=2000
STRYKE_MAXIMUM_MODEL_PROBABILITY_BPS=9500
# Optional Polymarket relative-value baseline. Select it with
# STRYKE_ESTIMATOR=polymarket_relative_value (5m, 15m or 1h only).
STRYKE_POLY_ENTRY_EDGE_BPS=500
STRYKE_POLY_EXIT_EDGE_BPS=200
STRYKE_POLY_MAX_SPREAD_BPS=1000
STRYKE_POLY_MAX_PRICE_AGE_MS=5000
STRYKE_POLY_TIMEOUT_MS=3000
STRYKE_POLYMARKET_CLOB_URL=https://clob.polymarket.com
STRYKE_API_BASE_URL=https://devnet-api.example.invalid
STRYKE_SOLANA_RPC_URL=https://api.devnet.solana.com
STRYKE_PYTH_HERMES_URL=https://hermes.pyth.network
STRYKE_CHECKPOINT_PATH=.stryke/reference-bot-action.json
# Required only by start:devnet. Follow docs/quickstart.md to generate and fund
# a dedicated devnet wallet. Its JSON contains private key material: keep it
# outside this repository and never commit or share it.
STRYKE_WALLET_ADAPTER_PATH=./examples/reference-bot/wallet-adapter.example.mjs
STRYKE_WALLET_KEYPAIR_PATH=../stryke-devnet-wallet.json
